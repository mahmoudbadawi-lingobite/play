rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function myRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isTeacher() {
      return isSignedIn() && myRole() == 'teacher';
    }

    function isAdmin() {
      return isSignedIn() && myRole() == 'admin';
    }

    // --- users ---
    // A user can read/create/update their own doc, but cannot grant
    // themselves 'teacher' or 'admin' role or approve their own request -
    // only an Admin can change role/teacherStatus on someone else's doc.
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid)
                    && request.resource.data.role == 'student'
                    && request.resource.data.teacherStatus == 'none';
      allow update: if isOwner(uid)
                    && request.resource.data.role == resource.data.role
                    && (request.resource.data.teacherStatus == resource.data.teacherStatus
                        || request.resource.data.teacherStatus == 'pending')
                    || isAdmin();
    }

    // --- content sets ---
    match /contentSets/{id} {
      allow read: if resource.data.visibility == 'public'
                  || (isSignedIn() && resource.data.teacherId == request.auth.uid)
                  || isAdmin();
      allow create: if isTeacher() && request.resource.data.teacherId == request.auth.uid;
      allow update: if (isSignedIn() && resource.data.teacherId == request.auth.uid)
                    || isAdmin()
                    // allow any signed-in user to bump playCount/reportCount only
                    || (isSignedIn()
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['playCount', 'reportCount']));
      allow delete: if (isSignedIn() && resource.data.teacherId == request.auth.uid) || isAdmin();
    }

    // --- content reports (write-only from clients, read by admin) ---
    match /contentReports/{id} {
      allow create: if isSignedIn();
      allow read: if isAdmin();
    }

    // --- classes ---
    match /classes/{id} {
      allow read: if isSignedIn(); // needed so a student can look up a class by join code
      allow create: if isTeacher() && request.resource.data.teacherId == request.auth.uid;
      allow update: if (isSignedIn() && resource.data.teacherId == request.auth.uid)
                    // allow a student to add themself via join code
                    || (isSignedIn()
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['studentIds'])
                        && request.resource.data.studentIds.hasAll(resource.data.studentIds));
      allow delete: if isSignedIn() && resource.data.teacherId == request.auth.uid;
    }

    // --- game results ---
    match /gameResults/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.studentId == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
